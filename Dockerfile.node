# Dockerfile for BashCoin Ledger Nodes
# Pin the base image for reproducible builds.
FROM alpine:3.20

# Install required packages.
# - socat provides the persistent, concurrent transaction listener
# - netcat-openbsd is used as the lightweight broadcast client
RUN apk add --no-cache \
    bash \
    rsync \
    jq \
    gnupg \
    openntpd \
    coreutils \
    bc \
    curl \
    netcat-openbsd \
    socat \
    procps

# Create necessary directories
RUN mkdir -p /data/ledger \
    /data/pending \
    /data/keys \
    /scripts \
    /config

# Copy network membership config (single source of truth for the node set)
COPY config/nodes.json /config/nodes.json

# Copy scripts
COPY scripts/nodes-lib.sh /scripts/
COPY scripts/init-node.sh /scripts/
COPY scripts/ledger-daemon.sh /scripts/
COPY scripts/create-transaction.sh /scripts/
COPY scripts/validate-transaction.sh /scripts/
COPY scripts/sync-ledger.sh /scripts/
COPY scripts/broadcast.sh /scripts/
COPY scripts/consensus.sh /scripts/
COPY scripts/fix-ledger.sh /scripts/
COPY scripts/import-keys.sh /scripts/
COPY scripts/entrypoint.sh /scripts/

# Make scripts executable
RUN chmod +x /scripts/*.sh

# Expose rsync daemon port (ledger + public key sharing)
EXPOSE 873/tcp

# Expose port for transaction broadcasting (TCP)
EXPOSE 9000/tcp

WORKDIR /data

ENTRYPOINT ["/scripts/entrypoint.sh"]

